# ============================================================================
# mcwake — konfiguracja. Skopiuj do .env i uzupełnij. NIE commituj .env.
# ============================================================================

# --- Publiczny adres (to na niego łączą się gracze) --------------------------
PUBLIC_PORT=25565
PUBLIC_MOTD_VERSION=1.20.4
PUBLIC_MOTD_PROTOCOL=765

# --- Prawdziwy serwer Minecraft (Wings/Pterodactyl na dedyku) ----------------
# lazymc stoi na Unraidzie w tej samej sieci LAN co dedyk, więc to zwykły
# lokalny adres IP dedyka (np. 192.168.1.50) — bez VPN-a, bez tunelu.
# To NIE jest adres publiczny.
MC_SERVER_HOST=192.168.1.50
MC_SERVER_PORT=25565

# --- Ustawienia lazymc --------------------------------------------------------
# start_timeout musi być większy niż realny czas budzenia całego hosta
# (WoL + boot Proxmoksa + Wings + start kontenera MC). Licz z zapasem.
LAZYMC_START_TIMEOUT_SECONDS=900
LAZYMC_STOP_TIMEOUT_SECONDS=180
# Jak długo (w sek.) lazymc czeka po odejściu ostatniego gracza zanim uśpi
# SAM kontener MC (nie cały komputer — to robi idle-reaper, patrz niżej).
LAZYMC_SLEEP_AFTER_SECONDS=1800

# Wiadomości — użyj dosłownego \n dla nowej linii, kody kolorów Minecrafta (§)
# działają. Unikaj znaku " wewnątrz treści.
LAZYMC_MOTD_SLEEPING=☠ Serwer śpi z powodu bezczynności\n§2☻ Dołącz, aby go uruchomić
LAZYMC_MOTD_STARTING=§2☻ Serwer się uruchamia...\n§7⌛ To może potrwać do 10 minut
LAZYMC_MOTD_STOPPING=☠ Serwer usypia...\n⌛ Spróbuj ponownie za chwilę
LAZYMC_KICK_STARTING_MESSAGE=Serwer był wyłączony z powodu długiej nieaktywności.\n\nRozpoczęto uruchamianie — może to potrwać do 10 minut.\n\nSpróbuj dołączyć ponownie za chwilę.
LAZYMC_KICK_STOPPING_MESSAGE=Serwer usypia po okresie bezczynności.\n\nSpróbuj dołączyć ponownie za chwilę, aby go zbudzić.

# --- Orchestrator (wewnętrzne API wywoływane przez lazymc/reaper/panel) -----
ORCHESTRATOR_PORT=7100
# Adres orchestratora widziany przez inne kontenery w tej samej sieci docker.
ORCHESTRATOR_URL=http://orchestrator:7100
# Wspólny sekret — wygeneruj losowy ciąg, np. `openssl rand -hex 32`.
ORCHESTRATOR_INTERNAL_TOKEN=change-me

# --- Pterodactyl ---------------------------------------------------------------
PTERODACTYL_URL=https://panel.example.com
# UWAGA: to NIE jest klucz z panelu admina ("Application API", ten ekran z
# listą uprawnień Nodes/Eggs/Users/...). Klucza szukaj we własnym koncie:
# kliknij swój avatar w prawym górnym rogu panelu → "API Credentials" →
# "Create New" — wystarczy opis, żadnych uprawnień do zaznaczania. To jest
# "Client API key", działa dla serwerów do których masz dostęp jako user.
PTERODACTYL_API_KEY=ptlc_xxx
# Krótki 8-znakowy identifier z paska adresu gdy wejdziesz na serwer w
# panelu: https://panel.example.com/server/XXXXXXXX <- to, nie pełny UUID
# (ten z myślnikami z zakładki Settings) i nie numeryczny ID z bazy.
PTERODACTYL_SERVER_ID=xxxxxxxx

# --- Proxmox ---------------------------------------------------------------
# Ten sam dedyk, ten sam LAN — lokalny adres IP, port domyślny 8006.
PROXMOX_HOST=https://192.168.1.50:8006
# Nazwa node'a, NIE nazwa hosta/domeny — widoczna w lewym panelu Proxmoksa
# pod "Datacenter" (np. w standardowej instalacji to "pve", ale bywa
# zmieniona przy instalacji, sprawdź w swoim UI).
PROXMOX_NODE=pve
# API Token: Datacenter → Permissions → API Tokens → Add.
# WAŻNE: przy tworzeniu odznacz "Privilege Separation" (albo osobno nadaj
# uprawnienia temu tokenowi w Datacenter → Permissions → Add) — inaczej
# token nie odziedziczy praw usera i shutdown node'a zwróci 403.
PROXMOX_TOKEN_ID=root@pam!mcwake
PROXMOX_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# true jeśli Proxmox używa self-signed certu (domyślnie tak).
PROXMOX_ALLOW_SELF_SIGNED=true

# --- Budzenie fizycznej maszyny ---------------------------------------------
# wol = Wake-on-LAN (spróbuj najpierw tego). tapo = wtyczka TP-Link Tapo
# (fallback, wymaga dokończenia integracji — patrz services/common/src/clients/tapo.ts)
POWER_ON_STRATEGY=wol

WOL_MAC_ADDRESS=AA:BB:CC:DD:EE:FF
# Unraid i dedyk są w tej samej sieci LAN, więc to zwykły broadcast tej sieci
# (np. dla 192.168.1.0/24 będzie to 192.168.1.255) — najprostszy i
# najpewniejszy wariant WoL, żadnego VPN-a w drodze.
WOL_TARGET_ADDRESS=192.168.1.255
WOL_PORT=9

# Nieużywane dopóki POWER_ON_STRATEGY=tapo i tapo.ts nie zostanie dokończone.
TAPO_ENABLED=false
TAPO_EMAIL=
TAPO_PASSWORD=
TAPO_DEVICE_IP=

# Jak długo (w sek.) czekać aż host odpowie po WoL/Tapo zanim uznamy to za fail.
HOST_BOOT_TIMEOUT_SECONDS=600
HOST_POLL_INTERVAL_SECONDS=5

# --- Idle-reaper (warstwa 2 — wyłączanie CAŁEGO hosta po długiej ciszy) -----
IDLE_REAPER_ENABLED=true
IDLE_REAPER_THRESHOLD_DAYS=7
IDLE_REAPER_POLL_INTERVAL_MINUTES=30

# --- Wspólna baza SQLite (last-seen, zdarzenia) -----------------------------
SQLITE_PATH=/data/mcwake.db

# --- Panel webowy ---------------------------------------------------------------
WEB_PORT=8080
WEB_PASSWORD=change-me
# Sekret do podpisywania cookie sesji — wygeneruj losowy ciąg.
WEB_SESSION_SECRET=change-me-too
