# ============================================================================
# mcwake — konfiguracja orchestratora na serwerze domowym. Skopiuj do .env.
# NIE commituj .env. lazymc na VPS ma osobny .env (docker-compose.vps.yml).
# ============================================================================

# --- API orchestratora ----------------------------------------------------------
ORCHESTRATOR_PORT=7100
# Adres Tailscale tego hosta - tylko na nim publikowany jest port API.
ORCHESTRATOR_BIND_ADDRESS=100.x.y.z
# Pełny dostęp: dashboard. openssl rand -hex 32
ORCHESTRATOR_INTERNAL_TOKEN=
# Token lazymc: tylko /wake, /sleep i /config/lazymc. Ta sama wartość idzie do
# .env lazymc na VPS jako ORCHESTRATOR_INTERNAL_TOKEN. Puste = lazymc używa
# pełnego tokenu (jak dawniej).
ORCHESTRATOR_LAZYMC_TOKEN=
SQLITE_PATH=/data/mcwake.db

# --- Prawdziwy serwer Minecraft --------------------------------------------------
# Adres w LAN serwera gry (alokacja w Pterodactylu) - do sprawdzania, czy
# Minecraft odpowiada i kto gra.
MC_SERVER_HOST=192.168.1.80
MC_SERVER_PORT=25565

# --- lazymc (tylko do raportu stanu komponentów) -----------------------------------
# Adres VPS z lazymc w Tailscale i jego publiczny port.
LAZYMC_HOST=100.x.y.z
PUBLIC_PORT=25565

# --- Pterodactyl ---------------------------------------------------------------------
PTERODACTYL_URL=https://panel.example.com
# Klucz Client API (nie Application API) konta, które ma dostęp do serwera.
# Najlepiej osobne konto, podużytkownik tylko tego serwera z prawem do zasilania.
PTERODACTYL_API_KEY=ptlc_xxx
# 8-znakowy identyfikator z adresu serwera w panelu.
PTERODACTYL_SERVER_ID=xxxxxxxx

# --- Host gry: Wings bez hypervisora ---------------------------------------------------
# Bezpośredni adres API Wings w LAN (http, api.port z config.yml), NIE nazwa
# za Cloudflare - tunel odpowiada także wtedy, gdy maszyna jest wyłączona.
WINGS_URL=http://192.168.1.80:8080
# Wyłączanie przez SSH. Klucz i known_hosts leżą w wolumenie /data; wpis na hoście
# w /root/.ssh/authorized_keys:
#   restrict,command="/usr/bin/systemctl poweroff",from="<WOL_LAN_ADDRESS>" ssh-ed25519 AAAA... mcwake-poweroff
HOST_SSH_TARGET=root@192.168.1.80
HOST_SSH_KEY=/data/ssh/id_ed25519
HOST_SSH_KNOWN_HOSTS=/data/ssh/known_hosts

# --- Wake-on-LAN -----------------------------------------------------------------------
WOL_MAC_ADDRESS=AA:BB:CC:DD:EE:FF
# Adres rozgłoszeniowy LAN (np. 192.168.1.255), nie IP hosta - wyłączony host
# nie odpowie na ARP.
WOL_TARGET_ADDRESS=192.168.1.255
WOL_PORT=9
# Noga orchestratora w LAN: wolny, stały adres i istniejąca sieć ipvlan/macvlan
# hosta Dockera (Unraid: br0). Bez niej pakiet WoL nie wyjdzie z Dockera.
WOL_LAN_ADDRESS=192.168.1.81
WOL_LAN_NETWORK=br0

# --- Czasy ----------------------------------------------------------------------------
# Ile czekać, aż wybudzony host odpowie przez Wings.
HOST_BOOT_TIMEOUT_SECONDS=600
HOST_POLL_INTERVAL_SECONDS=5
# Ile czekać, aż Minecraft po starcie zacznie odpowiadać.
LAZYMC_START_TIMEOUT_SECONDS=900

# --- lazymc na VPS ------------------------------------------------------------------------
# Webhook Arcane, który restartuje projekt lazymc (po zmianie MOTD, trybie
# przerwy). Adres zawiera token - to on jest sekretem.
ARCANE_LAZYMC_WEBHOOK_URL=

# --- Wartości domyślne ustawień edytowalnych w dashboardzie -------------------------------
# Dashboard zapisuje nadpisania w bazie; tu tylko wartości wyjściowe.
LAZYMC_SLEEP_AFTER_SECONDS=1800
LAZYMC_FORGE=false
IDLE_REAPER_ENABLED=true
IDLE_REAPER_THRESHOLD_MINUTES=10080
IDLE_REAPER_POLL_INTERVAL_MINUTES=30
SLEEP_TRIGGERS_FULL_SHUTDOWN=false
